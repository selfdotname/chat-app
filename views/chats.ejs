<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/styles.css">
        <script src="https://js.pusher.com/8.4.0/pusher.min.js"></script>
        <title>Chat App - Obaro</title>
    </head>
    <body>
        <div class="w-full max-w-180 p-4">
            <div class="text-xs text-[#555]">Hello, <%= name %> (user id: <span class="uid"><%= uid %></span>)</div>
            <form action="/chats" method="post" enctype="application/x-www-form-urlencoded" class="space-y-2">
                <h2 class="text-6xl font-bold mt-4">Start chat</h2>
                <p class="text-xl font-extralight">Enter recipient user id</p>
                <input type="text" name="recipient_id" class="p-4 rounded-lg outline-0 border border-blue-400 focus:border-4">
                <button class="w-45 py-3 rounded-lg bg-blue-400 text-white font-bold">Start Chat</button>
            </form>
            <h2 class="font-bold mt-2">Chats</h2>
            <ul class="space-y-4 flex flex-wrap gap-2">
                <% for (const chat of chats) { %>
                    <li>
                        <a href="/chats/<%= chat._id.toHexString() %>" 
                            class="inline-block p-4 bg-blue-200 hover:bg-blue-300 rounded-lg hover:shadow">
                            <%= chat.user1.name == name ? chat.user2.name : chat.user1.name %>
                        </a>
                    </li>
                <% } %>
            </ul>
        </div>
        <script src="/chats.js"></script>
    </body>
</html>