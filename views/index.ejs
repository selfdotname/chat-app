<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/styles.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
        <title>Chat App - Obaro</title>
    </head>
    <body>
        <div class="absolute top-0 left-[50%] translate-x-[-50%] text-xs text-center text-gray-700 min-w-fit">Written end-to-end by &copy; Obaro 2026</div>
        <div class="absolute top-6 left-[50%] translate-x-[-50%] text-xs text-center text-gray-500 flex items-center flex-wrap justify-center gap-0.5">
            Powered by Vercel <i class="devicon-vercel-original"></i> | Express.js <i class="devicon-express-original"></i> | MongoDB <i class="devicon-mongodb-plain"></i> | Tailwindcss <i class="devicon-tailwindcss-original"></i> | Pusher.js
        </div>
        <form action="/" method="post" enctype="application/x-www-form-urlencoded"
        class="flex w-full h-dvh justify-center items-center flex-col gap-2">
            <h1 class="text-3xl font-bold text-center">What is your name?</h1>
            <input type="text" name="name" class="p-4 rounded-lg outline-0 border border-blue-400 focus:border-4" required>
            <button type="submit" class="w-45 py-3 rounded-lg bg-blue-400 text-white font-bold">Save</button>
        </form>
    </body>
</html>